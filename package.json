{
  "name": "harmos-front-end",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.5.0",
    "bootstrap": "^5.2.3",
    "bootstrap-icons": "^1.10.5",
    "date-fns": "^2.30.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-big-calendar": "^1.8.1",
    "react-bootstrap": "^2.7.4",
    "react-datepicker": "^4.12.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^12.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.12.0",
    "react-scripts": "^5.0.1",
    "serve": "^14.2.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "NODE_OPTIONS='--max-old-space-size=1024' react-scripts build && npm run copy-sw",
    "build:heroku": "NODE_OPTIONS='--max-old-space-size=460 --optimize-for-size' GENERATE_SOURCEMAP=false CI=false react-scripts build && npm run copy-sw",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "heroku-postbuild": "npm run build:heroku",
    "copy-sw": "cp public/sw.js build/sw.js",
    "analyze": "npm run build && npx source-map-explorer 'build/static/js/*.js'",
    "clear-cache": "rmdir /s /q node_modules\\.cache 2>nul & rmdir /s /q build 2>nul",
    "start:production": "serve -s build -l 3000"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "source-map": "^0.7.4"
  },
  "engines": {
    "node": "18.x",
    "npm": "9.x"
  }
}
